ENV=development
LOG_LEVEL=debug
API_PORT=8090

POSTGRES_USER=sahel
POSTGRES_PASSWORD=sahel_local_only
POSTGRES_DB=sahel
DATABASE_URL=postgres://sahel:sahel_local_only@postgres:5432/sahel?sslmode=disable

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=sahel-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# What browsers use to load uploaded images (not the in-network endpoint).
S3_PUBLIC_URL=http://localhost:9000/sahel-uploads

# Gates /api/v1/admin/* and /dashboard. No default on purpose.
ADMIN_PASSWORD=

NEXT_PUBLIC_API_URL=http://localhost:8090
